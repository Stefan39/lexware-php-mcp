{
    "name": "jacomeit/lexware-php-mcp",
    "description": "Unofficial read-only MCP server for Lexware Office (formerly lexoffice), built on the official PHP MCP SDK. Not affiliated with Haufe Group.",
    "type": "project",
    "license": "MIT",
    "keywords": ["mcp", "model-context-protocol", "lexware", "lexoffice", "claude"],
    "authors": [
        {
            "name": "Stefan Jacomeit",
            "homepage": "https://www.jacomeit.de"
        }
    ],
    "require": {
        "php": ">=8.4",
        "mcp/sdk": "^0.9",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4.23 || ^8.1.11"
    },
    "autoload": {
        "psr-4": {
            "Jacomeit\\LexwarePhpMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jacomeit\\LexwarePhpMcp\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/lexware-php-mcp"],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse --configuration phpstan.dist.neon --memory-limit 512M",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "tests": "vendor/bin/phpunit",
        "check": ["@cs", "@phpstan", "@tests"]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^12.5"
    },
    "conflict": {
        "symfony/filesystem": "<7.4.23 || >=8.0,<8.1.11"
    }
}
